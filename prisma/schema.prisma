// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  image       String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Media {
  id                String         @id @default(cuid())
  type             String
  imageUrl         String?
  youtubeUrl       String?
  videoUrl         String?
  alt              String
  rentreePourTous  RentreePourTous @relation(fields: [rentreePourTousId], references: [id], onDelete: Cascade)
  rentreePourTousId String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Testimonial {
  id          String    @id @default(cuid())
  name        String
  content     String    @db.Text
  role        String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Hero {
  id              String   @id @default(cuid())
  title           String
  subtitle        String
  backgroundImage String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vision {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  mission     Mission  @relation(fields: [missionId], references: [id])
  missionId   String   @unique
  images      Images   @relation(fields: [imagesId], references: [id])
  imagesId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  vision      Vision?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Images {
  id     String  @id @default(cuid())
  top    String
  bottom String
  vision Vision?
}

model Valeur {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  image         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  published     Boolean  @default(true)
  rentreePourTous RentreePourTous? @relation("ProjectToRentree")
}

model CTA {
  id              String   @id @default(cuid())
  parrain         Parrain  @relation(fields: [parrainId], references: [id])
  parrainId       String   @unique
  don             Don      @relation(fields: [donId], references: [id])
  donId           String   @unique
  backgroundImage String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Parrain {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  buttonText  String
  cta         CTA?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Don {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  buttonText  String
  cta         CTA?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model About {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Section Hero
  heroTitle   String   @db.Text
  heroSubtitle String  @db.Text
  heroImage   String

  // Section Notre Histoire
  historyTitle String  @db.Text
  historyContent String @db.Text
  historyImage String

  // Section Notre Équipe
  teamTitle   String   @db.Text
  teamSubtitle String  @db.Text
  members     TeamMember[]

  // Section Nos Partenaires
  partnersTitle String @db.Text
  partnersSubtitle String @db.Text
  partners     Partner[]
}

model TeamMember {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  role        String
  description String   @db.Text
  image       String
  about       About    @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  aboutId     String
}

model Partner {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  logo        String
  website     String?
  about       About    @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  aboutId     String
}

model Support {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Hero Section
  heroTitle   String
  heroImage   String
  
  // Main Content
  title       String
  description String   @db.Text
  image       String
  
  // Form Fields
  formTitle   String?
  formDescription String? @db.Text
}

model Partnership {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Hero Section
  heroTitle   String
  heroImage   String
  
  // Main Content
  title       String
  description String   @db.Text
  image       String
  
  // Form Fields
  formTitle   String?
  formDescription String? @db.Text
}

model Donate {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Hero Section
  heroTitle   String
  heroSubtitle String
  heroImage   String
  
  // Main Content
  title       String
  description String   @db.Text
  
  // Benefits Section
  benefits    Benefit[]
  
  // Information Section
  infoTitle   String
  infoContent Info[]
}

model Benefit {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  text        String
  donate      Donate   @relation(fields: [donateId], references: [id], onDelete: Cascade)
  donateId    String
}

model Info {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  content     String   @db.Text
  donate      Donate   @relation(fields: [donateId], references: [id], onDelete: Cascade)
  donateId    String
}

model RentreePourTous {
  id          String   @id @default(cuid())
  projectId   String?  @unique
  project     Project? @relation("ProjectToRentree", fields: [projectId], references: [id])
  title       String
  location    String   @default("")
  description String   @db.Text
  participants Int     @default(0)
  status      String   @default("upcoming")
  heroTitle   String
  heroImage   String
  fundingGoal Float    @default(0)
  fundsRaised Float    @default(0)
  media       Media?
  gallery     Gallery[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id                String         @id @default(cuid())
  type             String
  imageUrl         String?
  youtubeUrl       String?
  videoUrl         String?
  alt              String
  rentreePourTous  RentreePourTous @relation(fields: [rentreePourTousId], references: [id], onDelete: Cascade)
  rentreePourTousId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model HomeGallery {
  id        String @id @default(cuid())
  title     String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                String   @id @default("1")
  siteName          String
  siteDescription   String   @db.Text
  logo              String
  favicon           String
  primaryColor      String
  secondaryColor    String
  accentColor       String
  paymentMethods    String   @db.Text
  stripePublicKey   String?
  stripeSecretKey   String?
  paypalClientId    String?
  paypalSecret      String?
  metaTitle         String
  metaDescription   String   @db.Text
  metaKeywords      String   @db.Text
  metaImage         String
  facebookUrl       String?
  twitterUrl        String?
  instagramUrl      String?
  linkedinUrl       String?
  youtubeUrl        String?
  contactEmail      String?
  contactPhone      String?
  contactAddress    String?
  contactCity       String?
  contactCountry    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SecuritySettings {
  id              String   @id @default("1")
  twoFactorAuth   Boolean  @default(false)
  sessionTimeout  Int      @default(30)
  passwordExpiry  Int      @default(90)
  maxLoginAttempts Int     @default(5)
  lockoutDuration Int      @default(15)
  allowedIPs      Json     @default("[]")
  sslEnabled      Boolean  @default(true)
  backupEnabled   Boolean  @default(true)
  backupFrequency String   @default("daily")
  backupRetention Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
